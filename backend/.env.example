# ============================================================
#  Trợ lý Tổng phụ trách Đội THCS — Backend environment
#  Sao chép tệp này thành `.env` rồi điền giá trị thật.
#  KHÔNG commit tệp `.env` lên git.
# ============================================================

# --- Cơ sở dữ liệu ------------------------------------------
# Khớp với docker-compose.yml ở thư mục gốc.
DATABASE_URL="postgresql://tpt:tpt_secret@localhost:5433/tpt_doi_thcs?schema=public"

# --- Máy chủ ------------------------------------------------
NODE_ENV=development
PORT=4000
# Nhiều origin ngăn bằng dấu phẩy.
CORS_ORIGIN="http://localhost:3000"

# --- Bảo mật ------------------------------------------------
# BẮT BUỘC đổi trong môi trường thật. Sinh chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# --- Tài khoản khởi tạo (chỉ dùng khi seed) -----------------
# Mật khẩu gốc của website cũ là "admin@" — được giữ làm mặc định
# để tương thích, nhưng người dùng BUỘC phải đổi ở lần đăng nhập đầu.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin@"
SEED_ADMIN_FULLNAME="Tổng phụ trách Đội"

# --- Tệp đính kèm -------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_MB=25

# --- Ghi log ------------------------------------------------
LOG_LEVEL="info"

# --- Giới hạn tần suất --------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
