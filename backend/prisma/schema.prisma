  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  campusId     String?    @map("campus_id") @db.Uuid
  campus       Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)

  name         String    @db.VarChar(120)
  internalCode String?   @map("internal_code") @db.VarChar(40)
  className    String    @map("class_name") @db.VarChar(50)
  classId      String?   @map("class_id") @db.Uuid
  class        Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  unit         String    @db.VarChar(120)
  teamUnitId   String?   @map("team_unit_id") @db.Uuid
  teamUnit     TeamUnit? @relation(fields: [teamUnitId], references: [id], onDelete: SetNull)
  position     String    @db.VarChar(80)
  term         String    @db.VarChar(60)
