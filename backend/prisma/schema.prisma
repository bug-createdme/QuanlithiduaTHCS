// ============================================================================
//  Trợ lý Tổng phụ trách Đội THCS — PostgreSQL schema
//  Thiết kế theo DATABASE_DESIGN.md, suy dẫn từ nghiệp vụ website gốc.
//  Quy ước: model PascalCase ↔ bảng snake_case; field camelCase ↔ cột snake_case.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUMS ──────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}
enum YearStatus {
  OPEN
  ARCHIVED
}
enum PlanLevel {
  YEAR
  SEMESTER
  MONTH
  WEEK
}
enum PlanStatus {
  DRAFT
  ACTIVE
  FINISHED
}
enum TaskStatus {
  TODO
  DOING
  WAITING
  REVIEW
  DONE
  PAUSED
}
enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum RepeatRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum DependencyType {
  FINISH_TO_START
  START_TO_START
}
enum ActivityStatus {
  PLANNED
  ACTIVE
  FINISHED
}
enum CriteriaFormula {
  BASE
  SUM
  WEIGHTED
}
enum CriteriaSetStatus {
  DRAFT
  ACTIVE
  STOPPED
}
enum CriterionDataType {
  SCORE
  COUNT
  BOOLEAN
  CHOICE
  NOTE
}
enum SheetStatus {
  DRAFT
  COMPLETE
  REVIEW
  APPROVED
  LOCKED
  UNLOCKED
}
enum EntryState {
  VALUE
  NA
  EXEMPT
}
enum ProgramStatus {
  DRAFT
  APPROVED
}
enum ApprovalStatus {
  DRAFT
  REVIEW
  APPROVED
}
enum DocumentStatus {
  DRAFT
  APPROVED
  ARCHIVED
}
enum AttachmentStatus {
  ACTIVE
  ARCHIVED
}
enum SyncStatus {
  PENDING
  SYNCED
}
enum EquipmentTxType {
  BORROW
  RETURN
  REPAIR
  DISPOSE
}
enum ReportType {
  WEEK
  SCORES
  TASKS
  ACTIVITIES
  EQUIPMENT
  YEAR_SUMMARY
}
enum ReportStatus {
  DRAFT
  FINALIZED
}
enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  ACCEPTED
}
enum CustomFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  DATE
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
  LINK
  FILE
}
enum SnapshotTier {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
  PROTECTED
}
enum BackupScope {
  QUICK
  FULL
  YEAR_PACKAGE
}
enum YearTransitionAction {
  CREATE
  CLOSE
  EDIT_OVERRIDE
}

// ──────────────────────── XÁC THỰC & NGƯỜI DÙNG ─────────────────────────────

/// Thay thế mật khẩu hard-code "admin@" của bản gốc.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique @db.VarChar(64)
  email           String?   @unique @db.VarChar(160)
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name") @db.VarChar(120)
  role            UserRole  @default(EDITOR)
  active          Boolean   @default(true)
  mustChangePassword Boolean @default(false) @map("must_change_password")

  /// Tái hiện SessionLockManager: backoff mũ 2 sau 3 lần sai, tối đa 30 giây.
  failedAttempts  Int       @default(0) @map("failed_attempts")
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  autoLockMinutes Int       @default(10) @map("auto_lock_minutes")

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision        Int       @default(1)

  sessions        Session[]
  auditLogs       AuditLog[]
  approvedSheets  WeeklyScoreSheet[] @relation("SheetApprover")
  lockedSheets    WeeklyScoreSheet[] @relation("SheetLocker")
  reports         GeneratedReport[]
  reportPackages  ReportPackage[]
  snapshots       Snapshot[]
  backupRecords   BackupRecord[]
  fileVersions    FileVersion[]
  yearTransitions YearTransitionLog[]

  @@index([active])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 của refresh token — không bao giờ lưu token thô.
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

// ──────────────────────── CƠ CẤU TỔ CHỨC TRƯỜNG ─────────────────────────────

model School {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(200)
  code          String?  @db.VarChar(50)
  address       String?  @db.VarChar(300)
  reporter      String?  @db.VarChar(120)
  reporterTitle String   @default("Tổng phụ trách Đội") @map("reporter_title") @db.VarChar(120)
  isSample      Boolean  @default(false) @map("is_sample")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  campuses    Campus[]
  schoolYears SchoolYear[]

  @@map("schools")
}

model Campus {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String @db.VarChar(120)
  /// Chỉ chữ không dấu, số, gạch ngang, gạch dưới — viết hoa. Duy nhất toàn hệ thống.
  code     String @unique @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  classes          Class[]
  plans            Plan[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  activities       Activity[]
  criteriaSets     CriteriaSet[]
  scoreSheets      WeeklyScoreSheet[]
  scoreEntries     ScoreEntry[]
  rankingSnapshots RankingSnapshot[]
  teamUnits        TeamUnit[]
  teamMembers      TeamMember[]
  programResults   ProgramResult[]
  commendations    Commendation[]
  documents        Document[]
  equipment        Equipment[]
  reports          GeneratedReport[]

  @@index([schoolId])
  @@map("campuses")
}

model SchoolYear {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(50)
  startDate DateTime   @map("start_date") @db.Date
  endDate   DateTime   @map("end_date") @db.Date
  /// Chỉ đúng một năm học được đánh dấu hiện hành.
  isCurrent Boolean    @default(false) @map("is_current")
  status    YearStatus @default(OPEN)
  readOnly  Boolean    @default(false) @map("read_only")
  closedAt  DateTime?  @map("closed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  semesters        Semester[]
  weeks            SchoolWeek[]
  classes          Class[]
  homeroomTeachers HomeroomTeacher[]
  plans            Plan[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  activities       Activity[]
  criteriaSets     CriteriaSet[]
  scoreSheets      WeeklyScoreSheet[]
  scoreEntries     ScoreEntry[]
  rankingSnapshots RankingSnapshot[]
  teamUnits        TeamUnit[]
  teamMembers      TeamMember[]
  programResults   ProgramResult[]
  commendations    Commendation[]
  documentFolders  DocumentFolder[]
  documents        Document[]
  equipment        Equipment[]
  reports          GeneratedReport[]
  reportPackages   ReportPackage[]
  snapshots        Snapshot[]

  @@unique([schoolId, name])
  @@index([isCurrent])
  @@map("school_years")
}

model Semester {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(50)
  startDate    DateTime   @map("start_date") @db.Date
  endDate      DateTime   @map("end_date") @db.Date
  sortOrder    Int        @default(1) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  weeks            SchoolWeek[]
  plans            Plan[]
  tasks            Task[]
  criteriaSets     CriteriaSet[]
  scoreSheets      WeeklyScoreSheet[]
  scoreEntries     ScoreEntry[]
  rankingSnapshots RankingSnapshot[]

  @@unique([schoolYearId, name])
  @@map("semesters")
}

/// 40 tuần sinh tự động từ ngày bắt đầu năm học, mỗi tuần 7 ngày.
model SchoolWeek {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId   String?    @map("semester_id") @db.Uuid
  semester     Semester?  @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  number       Int
  name         String     @db.VarChar(40)
  startDate    DateTime   @map("start_date") @db.Date
  endDate      DateTime   @map("end_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  scoreSheets      WeeklyScoreSheet[]
  scoreEntries     ScoreEntry[]
  rankingSnapshots RankingSnapshot[]

  @@unique([schoolYearId, number])
  @@index([schoolYearId, startDate])
  @@map("school_weeks")
}

model HomeroomTeacher {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  fullName     String     @map("full_name") @db.VarChar(120)
  phone        String?    @db.VarChar(30)
  email        String?    @db.VarChar(160)
  note         String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  classes Class[]

  @@index([schoolYearId])
  @@map("homeroom_teachers")
}

model Class {
  id                String           @id @default(uuid()) @db.Uuid
  schoolYearId      String           @map("school_year_id") @db.Uuid
  schoolYear        SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  campusId          String           @map("campus_id") @db.Uuid
  campus            Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  code              String?          @db.VarChar(30)
  className         String           @map("class_name") @db.VarChar(50)
  grade             Int
  /// Giữ nguyên kiểu text tự do như bản gốc; liên kết chuẩn hóa là tùy chọn.
  teacher           String?          @db.VarChar(120)
  homeroomTeacherId String?          @map("homeroom_teacher_id") @db.Uuid
  homeroomTeacher   HomeroomTeacher? @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  active            Boolean          @default(true)
  isSample          Boolean          @default(false) @map("is_sample")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  scoreEntries ScoreEntry[]
  teamMembers  TeamMember[]

  @@unique([schoolYearId, className])
  @@index([campusId])
  @@index([schoolYearId, active])
  @@map("classes")
}

// ─────────────────────────────── KẾ HOẠCH ───────────────────────────────────

model Plan {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId   String?    @map("semester_id") @db.Uuid
  semester     Semester?  @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  campusId     String?    @map("campus_id") @db.Uuid
  campus       Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)

  code         String     @db.VarChar(50)
  name         String     @db.VarChar(200)
  level        PlanLevel
  startDate    DateTime   @map("start_date") @db.Date
  endDate      DateTime   @map("end_date") @db.Date
  objectives   String
  targets      String?
  basis        String?
  coordination String?    @db.VarChar(200)
  resources    String?    @db.VarChar(200)
  risks        String?
  status       PlanStatus @default(DRAFT)
  progress     Int        @default(0)
  customValues Json?      @map("custom_values")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  planTargets PlanTarget[]

  @@index([schoolYearId, campusId])
  @@index([status])
  @@map("plans")
}

model PlanTarget {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(200)
  targetValue Decimal? @map("target_value") @db.Decimal(12, 2)
  actualValue Decimal? @map("actual_value") @db.Decimal(12, 2)
  unit        String?  @db.VarChar(30)
  sortOrder   Int      @default(1) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([planId, sortOrder])
  @@map("plan_targets")
}

// ─────────────────────────────── CÔNG VIỆC ──────────────────────────────────

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  schoolYearId String       @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId   String?      @map("semester_id") @db.Uuid
  semester     Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  campusId     String?      @map("campus_id") @db.Uuid
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)

  title        String       @db.VarChar(200)
  groupName    String?      @map("group_name") @db.VarChar(80)
  startDate    DateTime?    @map("start_date") @db.Date
  dueDate      DateTime     @map("due_date") @db.Date
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(TODO)
  progress     Int          @default(0)
  coordination String?      @db.VarChar(200)
  obstacle     String?
  notes        String?

  repeatRule          RepeatRule @default(NONE) @map("repeat_rule")
  repeatUntil         DateTime?  @map("repeat_until") @db.Date
  repeatNextAt        DateTime?  @map("repeat_next_at") @db.Date
  repeatSourceId      String?    @map("repeat_source_id") @db.Uuid
  repeatSource        Task?      @relation("TaskRepeat", fields: [repeatSourceId], references: [id], onDelete: SetNull)
  repeatOccurrences   Task[]     @relation("TaskRepeat")
  /// "{sourceId}:{dueDate}" — chống sinh trùng bản lặp.
  repeatOccurrenceKey String?    @unique @map("repeat_occurrence_key") @db.VarChar(120)

  customValues Json?   @map("custom_values")
  isSample     Boolean @default(false) @map("is_sample")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  checkItems   TaskCheckItem[]
  dependencies TaskDependency[] @relation("TaskOwner")
  dependents   TaskDependency[] @relation("TaskDependsOn")

  @@index([schoolYearId, status])
  @@index([dueDate])
  @@index([campusId])
  @@index([repeatNextAt])
  @@map("tasks")
}

model TaskCheckItem {
  id        String  @id @default(uuid()) @db.Uuid
  taskId    String  @map("task_id") @db.Uuid
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String  @db.VarChar(200)
  /// Dòng bắt đầu bằng "!" trong textarea checklist.
  required  Boolean @default(false)
  done      Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([taskId, sortOrder])
  @@map("task_check_items")
}

model TaskDependency {
  id          String         @id @default(uuid()) @db.Uuid
  taskId      String         @map("task_id") @db.Uuid
  task        Task           @relation("TaskOwner", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String         @map("depends_on_id") @db.Uuid
  dependsOn   Task           @relation("TaskDependsOn", fields: [dependsOnId], references: [id], onDelete: Restrict)
  type        DependencyType @default(FINISH_TO_START)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

/// 16 mẫu hard-code trong showTaskTemplates() của bản gốc, nay là dữ liệu.
model TaskTemplate {
  id                   String  @id @default(uuid()) @db.Uuid
  title                String  @db.VarChar(200)
  groupName            String  @default("Mẫu tham khảo") @map("group_name") @db.VarChar(80)
  defaultDueOffsetDays Int     @default(7) @map("default_due_offset_days")
  sortOrder            Int     @default(1) @map("sort_order")
  active               Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([active, sortOrder])
  @@map("task_templates")
}

// ────────────────────────── LỊCH & HOẠT ĐỘNG ────────────────────────────────

model CalendarEvent {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  campusId     String?    @map("campus_id") @db.Uuid
  campus       Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)

  title         String  @db.VarChar(200)
  date          DateTime @db.Date
  time          String? @db.VarChar(5)
  location      String? @db.VarChar(200)
  leader        String? @db.VarChar(120)
  category      String  @default("Hoạt động Đội") @db.VarChar(80)
  reminderHours Int     @default(24) @map("reminder_hours")
  /// Checklist an toàn — thiếu sẽ sinh cảnh báo mềm, không chặn lưu.
  safety        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([schoolYearId, date])
  @@index([campusId])
  @@map("calendar_events")
}

model Activity {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  campusId     String?    @map("campus_id") @db.Uuid
  campus       Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)

  name         String         @db.VarChar(200)
  category     String         @db.VarChar(100)
  theme        String?        @db.VarChar(150)
  date         DateTime       @db.Date
  location     String         @db.VarChar(200)
  leader       String         @db.VarChar(120)
  participants String?        @db.VarChar(200)
  objectives   String?
  safety       String
  backupPlan   String?        @map("backup_plan")
  result       String?
  status       ActivityStatus @default(PLANNED)
  customValues Json?          @map("custom_values")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([schoolYearId, date])
  @@index([status])
  @@map("activities")
}

// ──────────────────────── THI ĐUA (cụm trung tâm) ───────────────────────────

model CriteriaSet {
  id           String            @id @default(uuid()) @db.Uuid
  schoolYearId String            @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear        @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId   String?           @map("semester_id") @db.Uuid
  semester     Semester?         @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  campusId     String?           @map("campus_id") @db.Uuid
  campus       Campus?           @relation(fields: [campusId], references: [id], onDelete: SetNull)

  name          String            @db.VarChar(200)
  version       String            @default("1.0") @db.VarChar(20)
  formula       CriteriaFormula   @default(BASE)
  baseScore     Decimal           @default(100) @map("base_score") @db.Decimal(8, 2)
  status        CriteriaSetStatus @default(DRAFT)
  effectiveFrom DateTime?         @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  basis         String?
  /// true khi bộ đã phát sinh bảng điểm — khóa cấu trúc, chỉ cho nhân bản.
  lockedVersion Boolean           @default(false) @map("locked_version")
  sourceSetId   String?           @map("source_set_id") @db.Uuid
  sourceSet     CriteriaSet?      @relation("CriteriaSetVersion", fields: [sourceSetId], references: [id], onDelete: SetNull)
  derivedSets   CriteriaSet[]     @relation("CriteriaSetVersion")
  isSample      Boolean           @default(false) @map("is_sample")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  criteria         Criterion[]
  scoreSheets      WeeklyScoreSheet[]
  rankingSnapshots RankingSnapshot[]

  @@unique([schoolYearId, name, version])
  @@index([status])
  @@map("criteria_sets")
}

model Criterion {
  id            String            @id @default(uuid()) @db.Uuid
  criteriaSetId String            @map("criteria_set_id") @db.Uuid
  criteriaSet   CriteriaSet       @relation(fields: [criteriaSetId], references: [id], onDelete: Cascade)

  code             String            @db.VarChar(20)
  groupName        String?           @map("group_name") @db.VarChar(80)
  name             String            @db.VarChar(200)
  description      String?
  dataType         CriterionDataType @default(SCORE) @map("data_type")
  points           Decimal           @default(0) @db.Decimal(8, 2)
  minValue         Decimal?          @map("min_value") @db.Decimal(8, 2)
  maxValue         Decimal?          @map("max_value") @db.Decimal(8, 2)
  decimals         Int               @default(0)
  weight           Decimal           @default(1) @db.Decimal(6, 2)
  sortOrder        Int               @default(99) @map("sort_order")
  color            String            @default("#0b6bcb") @db.VarChar(7)
  evidenceRequired Boolean           @default(false) @map("evidence_required")
  active           Boolean           @default(true)
  sourceCriteriaId String?           @map("source_criteria_id") @db.Uuid
  sourceCriteria   Criterion?        @relation("CriterionVersion", fields: [sourceCriteriaId], references: [id], onDelete: SetNull)
  derivedCriteria  Criterion[]       @relation("CriterionVersion")
  isSample         Boolean           @default(false) @map("is_sample")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  scoreEntries ScoreEntry[]

  @@unique([criteriaSetId, code])
  @@index([criteriaSetId, sortOrder])
  @@map("criteria")
}

model WeeklyScoreSheet {
  id            String      @id @default(uuid()) @db.Uuid
  schoolYearId  String      @map("school_year_id") @db.Uuid
  schoolYear    SchoolYear  @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId    String?     @map("semester_id") @db.Uuid
  semester      Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  campusId      String?     @map("campus_id") @db.Uuid
  campus        Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  weekId        String      @map("week_id") @db.Uuid
  week          SchoolWeek  @relation(fields: [weekId], references: [id], onDelete: Restrict)
  criteriaSetId String      @map("criteria_set_id") @db.Uuid
  criteriaSet   CriteriaSet @relation(fields: [criteriaSetId], references: [id], onDelete: Restrict)

  status       SheetStatus @default(DRAFT)
  approvedAt   DateTime?   @map("approved_at") @db.Timestamptz(3)
  approvedById String?     @map("approved_by_id") @db.Uuid
  approvedBy   User?       @relation("SheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lockedAt     DateTime?   @map("locked_at") @db.Timestamptz(3)
  lockedById   String?     @map("locked_by_id") @db.Uuid
  lockedBy     User?       @relation("SheetLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  unlockedAt   DateTime?   @map("unlocked_at") @db.Timestamptz(3)
  /// Bắt buộc tối thiểu 5 ký tự khi mở khóa.
  unlockReason String?     @map("unlock_reason")
  /// Đóng băng bộ tiêu chí tại thời điểm khóa — bảo đảm truy vết lịch sử.
  criteriaSnapshot Json?   @map("criteria_snapshot")
  reportsStale     Boolean @default(false) @map("reports_stale")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  entries          ScoreEntry[]
  rankingSnapshots RankingSnapshot[]

  @@unique([weekId, criteriaSetId, campusId])
  @@index([schoolYearId, status])
  @@index([weekId])
  @@map("weekly_score_sheets")
}

model ScoreEntry {
  id           String           @id @default(uuid()) @db.Uuid
  sheetId      String           @map("sheet_id") @db.Uuid
  sheet        WeeklyScoreSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  schoolYearId String           @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId   String?          @map("semester_id") @db.Uuid
  semester     Semester?        @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  campusId     String?          @map("campus_id") @db.Uuid
  campus       Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  weekId       String           @map("week_id") @db.Uuid
  week         SchoolWeek       @relation(fields: [weekId], references: [id], onDelete: Restrict)
  classId      String           @map("class_id") @db.Uuid
  class        Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  criteriaId   String           @map("criteria_id") @db.Uuid
  criterion    Criterion        @relation(fields: [criteriaId], references: [id], onDelete: Restrict)

  /// VALUE = có số; NA = "KAD" không áp dụng; EXEMPT = "MIỄN" được miễn.
  entryState EntryState @default(VALUE) @map("entry_state")
  value      Decimal?   @db.Decimal(10, 2)
  reason     String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  evidence ScoreEvidence[]

  @@unique([sheetId, classId, criteriaId])
  @@index([sheetId])
  @@index([classId])
  @@index([weekId])
  @@map("score_entries")
}

model ScoreEvidence {
  id           String      @id @default(uuid()) @db.Uuid
  scoreEntryId String      @map("score_entry_id") @db.Uuid
  scoreEntry   ScoreEntry  @relation(fields: [scoreEntryId], references: [id], onDelete: Cascade)
  attachmentId String?     @map("attachment_id") @db.Uuid
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  note         String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([scoreEntryId])
  @@map("score_evidence")
}

/// Bất biến — tạo tự động khi bảng tuần chuyển APPROVED → LOCKED.
model RankingSnapshot {
  id              String           @id @default(uuid()) @db.Uuid
  schoolYearId    String           @map("school_year_id") @db.Uuid
  schoolYear      SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semesterId      String?          @map("semester_id") @db.Uuid
  semester        Semester?        @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  campusId        String?          @map("campus_id") @db.Uuid
  campus          Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  weekId          String           @map("week_id") @db.Uuid
  week            SchoolWeek       @relation(fields: [weekId], references: [id], onDelete: Restrict)
  sheetId         String           @map("sheet_id") @db.Uuid
  sheet           WeeklyScoreSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  criteriaSetId   String           @map("criteria_set_id") @db.Uuid
  criteriaSet     CriteriaSet      @relation(fields: [criteriaSetId], references: [id], onDelete: Restrict)
  criteriaVersion String?          @map("criteria_version") @db.VarChar(20)
  /// [{ classId, className, campusId, total, filled, complete, rank }]
  rows            Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([weekId])
  @@index([sheetId])
  @@map("ranking_snapshots")
}

// ───────────────────── TỔ CHỨC ĐỘI & PHONG TRÀO ─────────────────────────────

model TeamUnit {
