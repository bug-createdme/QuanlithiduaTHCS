  @@index([campusId])
  @@map("equipment")
}

model EquipmentTransaction {
  id              String            @id @default(uuid()) @db.Uuid
  equipmentId     String            @map("equipment_id") @db.Uuid
  equipment       Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type            EquipmentTxType
  quantity        Int
  borrower        String?           @db.VarChar(120)
  borrowedAt      DateTime?         @map("borrowed_at") @db.Timestamptz(3)
  dueAt           DateTime?         @map("due_at") @db.Timestamptz(3)
  returnedAt      DateTime?         @map("returned_at") @db.Timestamptz(3)
  conditionBefore String?           @map("condition_before") @db.VarChar(40)
  conditionAfter  String?           @map("condition_after") @db.VarChar(40)
  note            String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([equipmentId, borrowedAt])
  @@map("equipment_transactions")
}

// ─────────────────────────────── BÁO CÁO ────────────────────────────────────

model GeneratedReport {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  campusId     String?    @map("campus_id") @db.Uuid
  campus       Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)

  name              String           @db.VarChar(250)
  type              ReportType
  version           Int              @default(1)
  status            ReportStatus     @default(DRAFT)
  /// true khi status = FINALIZED — API từ chối mọi PATCH/DELETE.
  immutable         Boolean          @default(false)
  recipient         String?          @db.VarChar(200)
  submissionStatus  SubmissionStatus @default(NOT_SUBMITTED) @map("submission_status")
  filters           Json?
  scope             Json?
  contentHtml       String?          @map("content_html")
  contentText       String?          @map("content_text")
  contentChecksum   String?          @map("content_checksum") @db.Char(64)
  sourceChecksum    String?          @map("source_checksum") @db.Char(64)
  sourceRecordCount Int              @default(0) @map("source_record_count")
  configSnapshot    Json?            @map("config_snapshot")
  generatedAt       DateTime         @default(now()) @map("generated_at") @db.Timestamptz(3)
  finalizedAt       DateTime?        @map("finalized_at") @db.Timestamptz(3)
  createdById       String?          @map("created_by_id") @db.Uuid
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@unique([schoolYearId, type, version])
  @@index([status, generatedAt])
  @@map("generated_reports")
}

model ReportPackage {
  id           String     @id @default(uuid()) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(250)
  checksum     String?    @db.Char(64)
  reportCount  Int        @default(0) @map("report_count")
  payload      Json
  createdById  String?    @map("created_by_id") @db.Uuid
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([schoolYearId])
  @@map("report_packages")
}

// ────────────────────────── CẤU HÌNH ĐỘNG ───────────────────────────────────

model ConfigCategory {
  id        String @id @default(uuid()) @db.Uuid
  key       String @unique @db.VarChar(60)
  name      String @db.VarChar(150)
  sortOrder Int    @default(1) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  items ConfigItem[]

  @@map("config_categories")
}

model ConfigItem {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @map("category_id") @db.Uuid
  category    ConfigCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Denormalize để truy vấn danh mục nhanh, không cần join.
  categoryKey String         @map("category_key") @db.VarChar(60)
  label       String         @db.VarChar(150)
  code        String         @db.VarChar(60)
  color       String         @default("#0b6bcb") @db.VarChar(7)
  icon        String         @default("•") @db.VarChar(8)
  sortOrder   Int            @default(99) @map("sort_order")
  description String?
  /// Ngừng dùng ≠ xóa: active=false vẫn giữ nguyên trong dữ liệu lịch sử.
  active      Boolean        @default(true)
  isDefault   Boolean        @default(false) @map("is_default")
  searchText  String?        @map("search_text")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@unique([categoryId, code])
  @@index([categoryKey, active, sortOrder])
  @@map("config_items")
}

model CustomFieldDefinition {
  id          String          @id @default(uuid()) @db.Uuid
  entityType  String          @map("entity_type") @db.VarChar(40)
  name        String          @db.VarChar(150)
  fieldType   CustomFieldType @default(SHORT_TEXT) @map("field_type")
  /// Các lựa chọn ngăn bằng dấu "|".
  options     String?
  description String?
  required    Boolean         @default(false)
  sortOrder   Int             @default(99) @map("sort_order")
  active      Boolean         @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@index([entityType, active, sortOrder])
  @@map("custom_field_definitions")
}

model AppSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

// ───────────────────────── NHẬT KÝ & SAO LƯU ────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.Uuid
  summary   String?
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  reason    String?
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, createdAt])
  @@index([entityId])
  @@index([userId])
  @@map("audit_logs")
}

/// Điểm khôi phục nội bộ — giữ 7 ngày · 4 tuần · 12 tháng; protected miễn trừ.
model Snapshot {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(250)
  tier         SnapshotTier @default(MANUAL)
  protected    Boolean      @default(false)
  reason       String?      @db.VarChar(80)
  schoolYearId String?      @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear?  @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  recordCount  Int          @default(0) @map("record_count")
  counts       Json?
  checksum     String?      @db.Char(64)
  /// Không chứa tệp nhị phân — tránh nhân đôi dung lượng.
  payload      Json
  createdById  String?      @map("created_by_id") @db.Uuid
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([tier, protected])
  @@map("snapshots")
}

model BackupRecord {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(250)
  scope       BackupScope @default(QUICK)
  size        BigInt      @default(0)
  checksum    String?     @db.Char(64)
  recordCount Int         @default(0) @map("record_count")
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdById String?     @map("created_by_id") @db.Uuid
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([completedAt])
  @@map("backup_records")
}

model MigrationLog {
  id          String    @id @default(uuid()) @db.Uuid
  fromSchema  Int?      @map("from_schema")
  toSchema    Int?      @map("to_schema")
  status      String    @db.VarChar(40)
  detail      Json?
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("migration_logs")
}

model YearTransitionLog {
  id         String               @id @default(uuid()) @db.Uuid
  fromYearId String?              @map("from_year_id") @db.Uuid
  toYearId   String?              @map("to_year_id") @db.Uuid
  action     YearTransitionAction
  reason     String?
  detail     Json?
  userId     String?              @map("user_id") @db.Uuid
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("year_transition_logs")
}
