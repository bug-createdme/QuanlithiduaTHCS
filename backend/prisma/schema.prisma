// ───────────────────────── HỒ SƠ – MINH CHỨNG ───────────────────────────────

model DocumentFolder {
  id           String           @id @default(uuid()) @db.Uuid
  schoolYearId String           @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  name         String           @db.VarChar(150)
  parentId     String?          @map("parent_id") @db.Uuid
  parent       DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocumentFolder[] @relation("FolderTree")
  sortOrder    Int              @default(1) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  documents Document[]

  @@unique([schoolYearId, parentId, name])
  @@map("document_folders")
}

model Document {
  id           String          @id @default(uuid()) @db.Uuid
  schoolYearId String          @map("school_year_id") @db.Uuid
  schoolYear   SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  campusId     String?         @map("campus_id") @db.Uuid
  campus       Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  folderId     String?         @map("folder_id") @db.Uuid
  folder       DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  name         String         @db.VarChar(250)
  type         String         @db.VarChar(80)
  documentNo   String?        @map("document_no") @db.VarChar(80)
  issuer       String?        @db.VarChar(150)
  date         DateTime?      @db.Date
  related      String?        @db.VarChar(200)
  tags         String?        @db.VarChar(250)
  description  String?
  status       DocumentStatus @default(DRAFT)
  pinned       Boolean        @default(false)
  /// Chuẩn hóa bỏ dấu của name+tags+description+documentNo — phục vụ GIN index.
  searchText   String?        @map("search_text")
  customValues Json?          @map("custom_values")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  attachments Attachment[]
  links       DocumentLink[]

  @@index([schoolYearId, folderId])
  @@index([pinned, updatedAt])
  @@index([deletedAt])
  @@map("documents")
}

model Attachment {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName   String           @map("file_name") @db.VarChar(250)
  extension  String?          @db.VarChar(12)
  mimeType   String?          @map("mime_type") @db.VarChar(120)
  size       BigInt           @default(0)
  /// SHA-256 như bản gốc.
  checksum   String?          @db.Char(64)
  storagePath String          @map("storage_path")
  version    Int              @default(1)
  status     AttachmentStatus @default(ACTIVE)
  syncStatus SyncStatus       @default(SYNCED) @map("sync_status")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  versions FileVersion[]
  evidence ScoreEvidence[]

  @@index([documentId, version])
  @@index([checksum])
  @@map("attachments")
}

model FileVersion {
  id           String     @id @default(uuid()) @db.Uuid
  attachmentId String     @map("attachment_id") @db.Uuid
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  version      Int
  fileName     String     @map("file_name") @db.VarChar(250)
  size         BigInt     @default(0)
  checksum     String?    @db.Char(64)
  storagePath  String     @map("storage_path")
  replacedAt   DateTime?  @map("replaced_at") @db.Timestamptz(3)
  replacedById String?    @map("replaced_by_id") @db.Uuid
  replacedBy   User?      @relation(fields: [replacedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@unique([attachmentId, version])
  @@map("file_versions")
}

/// Liên kết hồ sơ với bản ghi nghiệp vụ bất kỳ (polymorphic).
model DocumentLink {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String   @map("entity_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int       @default(1)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

// ─────────────────────────────── THIẾT BỊ ───────────────────────────────────

model Equipment {
