# ============================================================
#  Biến môi trường ở THƯ MỤC GỐC — chỉ dùng khi chạy toàn bộ
#  hệ thống bằng Docker (docker/docker-compose.full.yml).
#  Khi phát triển thông thường, chỉ cần backend/.env và
#  frontend/.env.local.
#
#  Sao chép tệp này thành `.env`. KHÔNG commit tệp `.env`.
# ============================================================

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=tpt
POSTGRES_PASSWORD=tpt_secret
POSTGRES_DB=tpt_doi_thcs
# Cổng trên máy chủ. Dùng 5433 để không đụng PostgreSQL cài sẵn ở 5432.
POSTGRES_PORT=5433
ADMINER_PORT=8081

# --- Khóa bí mật (BẮT BUỘC đổi khi dùng thật) ---------------
# Sinh chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Ứng dụng -----------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
MAX_FILE_MB=25
LOG_LEVEL=info
