# ============================================================================
#  Biến môi trường cho bản chạy thật.
#
#  Chép tệp này thành `.env` ở THƯ MỤC GỐC của dự án (không phải trong docker/):
#      cp docker/env.prod.example .env
#
#  Rồi điền đủ các giá trị bên dưới. Tệp `.env` đã nằm trong .gitignore.
# ============================================================================

# --- Tên miền ---------------------------------------------------------------
# Chỉ ghi tên miền, KHÔNG kèm https:// và không kèm dấu / ở cuối.
# Tên miền này phải đã trỏ bản ghi A về địa chỉ IP của máy chủ TRƯỚC khi chạy,
# vì Caddy cần xác thực quyền sở hữu để xin chứng chỉ Let's Encrypt.
DOMAIN=thidua.truong-cua-ban.id.vn

# --- Múi giờ ----------------------------------------------------------------
# BẮT BUỘC giữ nguyên nếu trường ở Việt Nam.
#
# today() trong backend/src/lib/dates.ts lấy ngày theo giờ hệ thống. Máy chủ
# Linux mặc định chạy UTC, chậm hơn Việt Nam 7 tiếng — nghĩa là từ 00:00 đến
# 07:00 giờ Việt Nam, hệ thống sẽ tưởng vẫn là ngày hôm qua. Sai lệch này lan
# sang công việc lặp, lịch tuần, bảng điều khiển và sổ điểm tuần.
TZ=Asia/Ho_Chi_Minh

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=tpt
POSTGRES_DB=tpt_doi_thcs
# ĐỔI GIÁ TRỊ NÀY. Sinh mật khẩu mạnh:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Khóa bí mật ------------------------------------------------------------
# BẮT BUỘC điền, và hai khóa phải KHÁC NHAU. Backend từ chối khởi động nếu
# thiếu khi NODE_ENV=production. Sinh từng chuỗi bằng:
#   openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Tài khoản quản trị đầu tiên --------------------------------------------
# Chỉ dùng ở bước seed lần đầu. Đặt mật khẩu thật ngay tại đây để trên máy chủ
# KHÔNG bao giờ tồn tại mật khẩu mặc định `admin@`, kể cả trong khoảng thời gian
# ngắn giữa lúc seed xong và lúc bạn đăng nhập đổi mật khẩu.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=Tổng phụ trách Đội

# --- Tùy chọn ---------------------------------------------------------------
# Dung lượng tối đa cho MỖI tệp tải lên (MB). Backend cho tối đa 20 tệp/lượt.
MAX_FILE_MB=25
# Giới hạn kích thước một yêu cầu ở tầng Caddy. Nên lớn hơn MAX_FILE_MB đáng kể
# để backend còn kịp trả thông báo tiếng Việt thay vì bị Caddy cắt ngang.
MAX_BODY_SIZE=200MB
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
